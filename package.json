{
  "name": "safetly",
  "version": "1.0.0",
  "private": true,
  "description": "Safetly – natteravner i nabolaget. PWA med Supabase, pakket med Capacitor.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "icons": "python3 scripts/make_icons.py",
    "sync": "npm run build && npx cap sync",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test": "node scripts/smoke.cjs",
    "test:db": "bash scripts/test_db.sh",
    "video": "node scripts/demo-video.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.119.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0"
  }
}
